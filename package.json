{
  "name": "codex-workbench",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --max-old-space-size=384 server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "password": "node scripts/password.mjs",
    "package": "node scripts/package.mjs",
    "test:real": "node scripts/real-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@tanstack/react-virtual": "3.14.21",
    "@uiw/react-codemirror": "4.25.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "busboy": "1.6.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tar": "7.5.22",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
