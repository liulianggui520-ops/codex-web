# Linux production values. The installer writes /etc/codex-workbench.env.
PUBLIC_ORIGIN=https://codex.example.com
PORT=47832
DATA_DIR=/var/lib/codex-workbench/web
CODEX_HOME=/var/lib/codex-workbench/codex
CODEX_SOCKET=/run/codex-workbench/engine.sock
WORKSPACE_ROOT=/srv/codex-workspaces
# Only for a local development preview, omit CODEX_SOCKET and set CODEX_BINARY.
# Persistent password is set using scripts/password.mjs, not this file.

UPDATE_SOCKET=/run/codex-workbench-updater/control.sock
